# DreamHost database connection. Use a database user with read-only access.
LIVE_DB_HOST=your-dreamhost-db-host
LIVE_DB_PORT=3306
LIVE_DB_NAME=your-database-name
LIVE_DB_USER=your-read-only-database-user
LIVE_DB_PASSWORD=replace-me
LIVE_DB_TABLE_PREFIX=wp_w4xbay_

# Production SFTP connection for downloading WordPress uploads.
LIVE_SFTP_HOST=your-dreamhost-sftp-host
LIVE_SFTP_PORT=22
LIVE_SFTP_USER=your-sftp-user
LIVE_SFTP_PASSWORD=replace-me
LIVE_SFTP_HOST_KEY=SHA256:replace-with-server-host-key-fingerprint
LIVE_SFTP_UPLOADS_PATH=/home/your-sftp-user/occasional-vegan.com/wp-content/uploads
